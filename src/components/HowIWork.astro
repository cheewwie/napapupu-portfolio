---
import { site } from '../lib/content';

// Accents are design, not copy: tile N takes accent N. A tile beyond the
// third gets no accent stripe rather than a decorative one.
const accents = ['leaf', 'orange', 'pink'];

const tiles = site.howIWork.tiles.map((tile, i) => ({ ...tile, accent: accents[i] ?? 'none' }));
---

<section class="work-section" aria-labelledby="work-heading">
  <div class="index-head">
    <h2 id="work-heading" class="index-label">{site.howIWork.heading}</h2>
  </div>
  <div class="work-grid">
    {
      tiles.map((tile) => (
        <div class={`work-tile work-tile--${tile.accent}`}>
          <h3 class="work-title">{tile.title}</h3>
          <p class="work-body">{tile.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .work-section {
    box-sizing: border-box;
    padding: 40px 72px 40px;
  }

  .index-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 0 0 14px;
    border-bottom: 1px solid var(--c-rule);
  }

  .index-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--c-body);
    font-weight: 700;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 22px;
  }

  .work-tile {
    box-sizing: border-box;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-border);
    border-radius: var(--radius);
    padding: 24px;
  }

  .work-tile--leaf {
    border-top-color: var(--c-leaf);
  }

  .work-tile--orange {
    border-top-color: var(--c-orange);
  }

  .work-tile--pink {
    border-top-color: var(--c-pink);
  }

  .work-title {
    margin: 0 0 10px;
    font-size: var(--fs-row);
    font-weight: var(--weight-heading);
    letter-spacing: var(--track-title);
    color: var(--c-headline);
  }

  .work-body {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-muted);
    font-weight: var(--weight-body);
  }

  @media (max-width: 900px) {
    .work-section {
      padding-left: 24px;
      padding-right: 24px;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
