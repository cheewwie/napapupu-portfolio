---
/**
 * A feedback quote: a colleague, client or stakeholder's verdict on the
 * work. Not for users' or participants' words — that is ResearchQuote. See
 * design/quote-pattern.md.
 */
export interface Props {
  attribution: string;
  /** Defaults to the project's own key colour, set as --case-dot by the case-study page. */
  accent?: string;
}

const { attribution, accent = 'var(--case-dot)' } = Astro.props;
---

<figure class="pullquote" style={{ borderColor: accent }}>
  <blockquote class="pullquote-text">
    <slot />
  </blockquote>
  <figcaption class="pullquote-attribution">{attribution}</figcaption>
</figure>

<style>
  .pullquote {
    margin: 0;
    padding: 2px 0 2px 24px;
    border-left: 4px solid;
  }

  /* Type sits on the blockquote, not the <p>, so one-line content (which
     MDX doesn't wrap in a paragraph) gets the same size. */
  .pullquote-text {
    margin: 0 0 14px;
    font-size: var(--fs-row);
    line-height: 1.5;
    color: var(--c-body);
    font-weight: var(--weight-body);
  }

  /* Inherit from the wrapper: `.chapter-body p` would otherwise give
     multi-paragraph quotes the muted prose style. */
  .pullquote-text :global(p) {
    margin: 0 0 14px;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  .pullquote-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .pullquote-attribution {
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    color: var(--c-muted);
  }
</style>
