---
export interface Props {
  client: string;
  role: string[];
  duration: string;
  outcome: string;
  access: string;
}

const { client, role, duration, outcome, access } = Astro.props;

const fields = [
  { label: 'Client', value: client },
  { label: 'Role', value: role },
  { label: 'Duration', value: duration },
  { label: 'Outcome', value: outcome },
  { label: 'Access', value: access },
];
---

<section class="spec-strip">
  <dl class="spec-grid">
    {
      fields.map((field) => (
        <div class="spec-field">
          <dt class="spec-label">{field.label}</dt>
          <dd class="spec-value">
            {Array.isArray(field.value)
              ? field.value.map((line, i) => (
                  <Fragment>
                    {i > 0 && <br />}
                    {line}
                  </Fragment>
                ))
              : field.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .spec-strip {
    box-sizing: border-box;
    padding: 0 64px 34px;
  }

  .spec-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid #24331f;
  }

  .spec-field {
    padding: 16px 20px;
    border-right: 1px solid var(--c-hairline);
  }

  .spec-field:first-child {
    padding-left: 0;
  }

  .spec-field:last-child {
    padding-right: 0;
    border-right: none;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--c-faint);
    margin-bottom: 7px;
  }

  .spec-value {
    margin: 0;
    font-size: 17px;
    font-weight: var(--weight-heading);
    color: var(--c-body);
  }

  @media (max-width: 900px) {
    .spec-strip {
      padding: 0 24px 24px;
    }

    .spec-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 16px;
    }

    .spec-field {
      border-right: none;
      padding: 0 12px;
    }

    .spec-field:first-child,
    .spec-field:last-child {
      padding: 0 12px;
    }
  }
</style>
