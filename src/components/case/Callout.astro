---
/** The one big question/idea a chapter turns on. Amber, matching the
 * reference — a decorative use the strict accent-role rule would flag, kept
 * deliberately per the same call made for the homepage's "How I work"
 * tiles: match the reference as-is. */
---

<div class="callout">
  <div class="callout-text">
    <slot />
  </div>
</div>

<style>
  .callout {
    padding: 2px 0 2px 24px;
    border-left: 4px solid var(--c-amber);
  }

  /* Type sits on the wrapper, not the <p>: one-line MDX content is not
     wrapped in a paragraph, and would otherwise fall back to 16px. */
  .callout-text {
    font-size: var(--fs-row);
    line-height: 1.42;
    font-weight: var(--weight-heading);
    letter-spacing: var(--track-row);
    color: var(--c-body);
  }

  /* Inherit from the wrapper: `.chapter-body p` would otherwise give
     multi-paragraph quotes the muted prose style. */
  .callout-text :global(p) {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
</style>
