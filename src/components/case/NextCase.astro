---
export interface Props {
  title: string;
  slug: string;
  ref: string;
}

const { title, slug, ref } = Astro.props;
---

<div class="next-case">
  <span class="next-label">Next</span>
  <a href={`/work/${slug}/`} class="next-link">Ref {ref} · {title} →</a>
</div>

<style>
  .next-case {
    box-sizing: border-box;
    padding: 26px 64px;
    border-top: 1px solid #24331f;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .next-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-faint);
  }

  .next-link {
    text-decoration: none;
    color: var(--c-headline);
    font-size: 19px;
    font-weight: var(--weight-heading);
    letter-spacing: -0.02em;
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
  }

  .next-link:hover,
  .next-link:focus-visible {
    color: var(--c-orange);
  }

  @media (max-width: 900px) {
    .next-case {
      padding: 22px 24px;
    }
  }
</style>
