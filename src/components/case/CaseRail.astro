---
import { site } from '../../lib/content';

const { chaptersHeading, artefactToggle: toggle } = site.caseRail;
---

<aside class="rail case-rail" id="rail" tabindex="-1">
  <p class="rail-label">{chaptersHeading}</p>
  <nav id="chapter-nav" class="chapter-nav"></nav>

  <div class="artefact-toggle-row" id="artefact-toggle-row">
    <button type="button" class="artefact-toggle" id="artefact-toggle" role="switch" aria-checked="true">
      <span class="switch-label">
        <span class="switch-label-title">{toggle.title}</span>
        <span class="switch-label-sub">{toggle.subtitle}</span>
      </span>
      <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
    </button>
  </div>
  <p
    class="marginalia"
    id="artefact-marginalia"
    data-note-shown-one={toggle.noteShownOne}
    data-note-shown-many={toggle.noteShownMany}
    data-note-hidden-one={toggle.noteHiddenOne}
    data-note-hidden-many={toggle.noteHiddenMany}
  ></p>
</aside>

<style>
  .rail {
    width: 240px;
    flex-shrink: 0;
    align-self: flex-start;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    box-sizing: border-box;
    background: var(--c-rail);
    border-left: 1px solid #24331f;
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
  }

  .rail-label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--c-faint);
  }

  .chapter-nav {
    display: flex;
    flex-direction: column;
    margin-bottom: 24px;
  }

  .chapter-nav :global(.chapter-nav-link) {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 9px 0;
    text-decoration: none;
    font-size: var(--fs-small);
    color: var(--c-faint);
  }

  .chapter-nav :global(.chapter-nav-dot) {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--c-amber);
    flex-shrink: 0;
    display: inline-block;
  }

  .chapter-nav :global(.is-current) {
    color: var(--c-headline);
    font-weight: var(--weight-strong);
  }

  .chapter-nav :global(.is-current .chapter-nav-dot) {
    width: 14px;
    height: 14px;
    border: 3px solid var(--c-amber);
    background: transparent;
    box-sizing: border-box;
    margin-left: -3px;
  }

  .chapter-nav :global(.is-upcoming) {
    color: var(--c-disabled);
  }

  .chapter-nav :global(.is-upcoming .chapter-nav-dot) {
    background: var(--c-border);
  }

  .artefact-toggle-row {
    margin-top: 0;
    margin-bottom: 10px;
  }

  .artefact-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: var(--tap-min);
    box-sizing: border-box;
    padding: 13px 14px;
    border-radius: var(--radius);
    background: transparent;
    border: 1px solid var(--c-border);
    cursor: pointer;
    text-align: left;
  }

  .switch-track {
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: var(--c-border);
    position: relative;
    flex-shrink: 0;
    display: inline-block;
    transition: background-color 120ms ease;
  }

  .switch-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--c-faint);
    display: block;
    transition: transform 120ms ease, background-color 120ms ease;
  }

  .artefact-toggle[aria-checked='true'] .switch-track {
    background: var(--c-amber);
  }

  .artefact-toggle[aria-checked='true'] .switch-thumb {
    background: var(--c-ground);
    transform: translateX(14px);
  }

  .switch-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
    min-width: 0;
  }

  .switch-label-title {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-headline);
  }

  .switch-label-sub {
    font-size: var(--fs-meta);
    line-height: 1.4;
    font-weight: var(--weight-body);
    color: var(--c-faint);
  }

  .marginalia {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: 1.7;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-faint);
  }

  /* Below 900px the rail becomes a drawer — same component, relocated, not
     a second design. See design/README.md and src/scripts/mobileDrawer.ts. */
  @media (max-width: 900px) {
    .rail {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(80%, 380px);
      height: 100vh;
      align-self: auto;
      border-left: 1px solid var(--c-border);
      border-top: none;
      padding: 42px 18px 84px;
      transform: translateX(100%);
      transition: transform 220ms ease;
      z-index: 40;
    }

    .rail.is-open {
      transform: translateX(0);
    }

    .chapter-nav :global(.chapter-nav-link) {
      min-height: var(--tap-min);
      padding: 6px 4px;
      gap: 14px;
      font-size: var(--fs-small);
    }

    .artefact-toggle-row {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--c-border);
    }

    .switch-track {
      width: 52px;
      height: 32px;
    }

    .switch-thumb {
      top: 4px;
      left: 4px;
      width: 24px;
      height: 24px;
    }

    .artefact-toggle[aria-checked='true'] .switch-thumb {
      transform: translateX(20px);
    }
  }
</style>
