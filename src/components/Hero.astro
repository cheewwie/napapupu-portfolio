---
import { site } from '../lib/content';

const { hero } = site;
---

<section class="hero">
  <p class="eyebrow">{hero.eyebrow}</p>
  <h1 class="hero-title">
    {hero.titleBefore} <span class="hero-annotated">{hero.titleCircled}</span>{hero.titleAfter}<span
      class="hero-dot"
      aria-hidden="true"></span>
  </h1>
  <p class="hero-lede">{hero.lede}</p>
  <div class="hero-availability">
    <span class="hero-availability-dot" aria-hidden="true"></span>
    <span class="hero-availability-label">{hero.availability}</span>
  </div>
</section>

<style>
  .hero {
    box-sizing: border-box;
    padding: 62px 72px 44px;
  }

  .eyebrow {
    margin: 0 0 24px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-mono-eyebrow);
    text-transform: uppercase;
    color: var(--c-amber);
  }

  .hero-title {
    margin: 0;
    max-width: 940px;
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: var(--weight-heading);
    letter-spacing: var(--track-display);
    color: var(--c-headline);
  }

  .hero-annotated {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  /* The annotation gesture, borrowed from the marked-up draft: pink, not UI. */
  .hero-annotated::after {
    content: '';
    position: absolute;
    left: -0.28em;
    right: -0.28em;
    top: -0.16em;
    bottom: -0.09em;
    border: 0.05em solid var(--c-pink);
    border-radius: 50%;
    transform: rotate(-1.2deg);
  }

  .hero-dot {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    border-radius: 999px;
    background: var(--c-amber);
    margin-left: 0.06em;
    vertical-align: baseline;
  }

  .hero-lede {
    margin: 26px 0 0;
    max-width: 720px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
    font-weight: var(--weight-body);
  }

  .hero-availability {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
  }

  .hero-availability-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--c-leaf);
    display: inline-block;
  }

  .hero-availability-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  @media (max-width: 900px) {
    .hero {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>
