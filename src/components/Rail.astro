---
import { site, type Project } from '../lib/content';

export interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Alice has no "On request" projects ready yet — hide the option until she does.
const SHOW_ON_REQUEST = false;

// Filter values must match the project data, so they live here; the labels
// shown for them live in src/content/site.json.
const { filters } = site.rail;

// "Coming soon" only earns a chip while at least one project carries it.
const hasComingSoon = projects.some((p) => p.access === 'Coming soon');

const accessOptions = [
  { value: 'all', label: filters.access.options.all },
  { value: 'open', label: filters.access.options.open },
  ...(SHOW_ON_REQUEST ? [{ value: 'on-request', label: filters.access.options['on-request'] }] : []),
  ...(hasComingSoon ? [{ value: 'coming-soon', label: filters.access.options['coming-soon'] }] : []),
];

const userOptions = (['all', 'pro', 'consumer'] as const).map((value) => ({
  value,
  label: filters.user.options[value],
}));

const deviceOptions = (['all', 'desktop', 'mobile', 'embedded'] as const).map((value) => ({
  value,
  label: filters.device.options[value],
}));

// Default state: every group at "all", so every option's initial count is
// simply how many projects it would include on its own — the live
// recompute (given the other two groups' selections) takes over client-side.
function initialCount(kind: 'access' | 'user' | 'device', value: string): number {
  if (value === 'all') return projects.length;
  return projects.filter((p) => {
    if (kind === 'access') return p.access.toLowerCase().replace(/\s+/g, '-') === value;
    if (kind === 'user') return p.user.toLowerCase() === value;
    return p.devices.some((d) => d.toLowerCase() === value);
  }).length;
}

const groups = [
  { key: 'access' as const, label: filters.access.label, options: accessOptions },
  { key: 'user' as const, label: filters.user.label, options: userOptions },
  { key: 'device' as const, label: filters.device.label, options: deviceOptions },
];
---

<aside class="rail" id="rail" tabindex="-1">
  {
    projects.length > 0 &&
      groups.map((group) => (
        <div class="filter-group">
          <p class="filter-label" data-filter-label={group.key}>
            {group.label}
          </p>
          <div class="filter-options" role="radiogroup" aria-label={group.label}>
            {group.options.map((opt, i) => (
              <button
                type="button"
                class="chip"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-group={group.key}
                data-value={opt.value}
              >
                <span class="chip-dot" aria-hidden="true" />
                <span class="chip-label">{opt.label}</span>
                <span class="chip-count" data-count>
                  {initialCount(group.key, opt.value)}
                </span>
              </button>
            ))}
          </div>
        </div>
      ))
  }
</aside>

<style>
  .rail {
    width: 240px;
    flex-shrink: 0;
    align-self: flex-start;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    box-sizing: border-box;
    background: var(--c-rail);
    border-left: 1px solid #24331f;
    padding: 26px 26px 26px 22px;
    display: flex;
    flex-direction: column;
  }

  .filter-group {
    margin-bottom: 30px;
  }

  .filter-label {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-mono-label);
    text-transform: uppercase;
    color: var(--c-faint);
  }

  .filter-group:first-child .filter-label {
    color: var(--c-amber);
  }

  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: var(--tap-min);
    box-sizing: border-box;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-align: left;
    border: none;
    background: transparent;
    color: var(--c-muted);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    flex-shrink: 0;
    background: #3c4f38;
  }

  .chip-count {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--c-faint);
  }

  .chip[aria-checked='true'] {
    background: var(--c-surface-raised);
    color: var(--c-headline);
  }

  .chip[aria-checked='true'] .chip-dot {
    background: var(--c-amber);
  }

  .chip:hover {
    color: var(--c-orange);
  }

  /* Below 900px the rail becomes a drawer — same component, relocated, not
     a second design. See design/README.md and src/scripts/mobileDrawer.ts. */
  @media (max-width: 900px) {
    .rail {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: min(80%, 380px);
      height: 100vh;
      align-self: auto;
      border-left: 1px solid var(--c-border);
      border-top: none;
      padding: 42px 18px 84px;
      transform: translateX(100%);
      transition: transform 220ms ease;
      z-index: 40;
    }

    .rail.is-open {
      transform: translateX(0);
    }
  }
</style>
